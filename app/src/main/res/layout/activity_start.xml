<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StartActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"

            android:gravity="center"

            android:shadowColor="#00BFFF"
            android:shadowDx="5"
            android:shadowDy="5"
            android:shadowRadius="10"

            android:text="Kakuro Master"


            android:textAlignment="center"
            android:textColor="#207FCE"
            android:textSize="55sp"
            android:textStyle="bold|italic"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Enter the realm of logic and sums. Play, think, and master the ultimate Kakuro challenge! "
            />

        <Button
            android:id="@+id/btnStartGuest"
            android:layout_width="320dp"
            android:layout_height="60dp"

            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="#05e2f2"

            android:gravity="center_vertical|center_horizontal"
            android:text=" PLAY AS GUEST"
            android:textAllCaps="false"

            android:textColor="@android:color/white"
            android:textSize="18sp"

            android:textStyle="bold"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textEnd"
            app:iconPadding="8dp"
            app:iconSize="20dp"

            app:iconTint="@android:color/white" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToLogin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"

                android:backgroundTint="#dee8fa"
                android:gravity="center_vertical|center_horizontal"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:letterSpacing="0.1"
                android:text="LOG IN"

                android:textAllCaps="true"
                android:textColor="#0a192e"
                android:textSize="14sp"
                android:textStyle="bold"

                app:cornerRadius="28dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconPadding="8dp"


                app:iconSize="24dp"
                app:iconTint="#207FCE"

                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="10"
                />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToRegister"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"

                android:backgroundTint="#dee8fa"
                android:gravity="center_vertical|center_horizontal"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:letterSpacing="0.1"
                android:text="REGISTER"

                android:textAllCaps="true"
                android:textColor="#0a192e"
                android:textSize="14sp"
                android:textStyle="bold"

                app:cornerRadius="28dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_register"
                app:iconGravity="textStart"
                app:iconPadding="8dp"


                app:iconSize="24dp"
                app:iconTint="#207FCE" />

        </LinearLayout>



    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>